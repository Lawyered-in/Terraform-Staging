apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd-ingress
  namespace: argo-cd
  annotations:
    kubernetes.io/ingress.class: alb
    # ALB Name
    alb.ingress.kubernetes.io/load-balancer-name: "${load_balancer_name}"
    # Target Type: IP
    alb.ingress.kubernetes.io/target-type: ip
    # Internet-facing scheme
    alb.ingress.kubernetes.io/scheme: internet-facing
    # Use all public subnets for High Availability
    alb.ingress.kubernetes.io/subnets: "${public_subnet_ids}"
    # Group name for resource sharing
    alb.ingress.kubernetes.io/group.name: "${group_name}"
    alb.ingress.kubernetes.io/group.order: "50"
    # Health Check path
    alb.ingress.kubernetes.io/healthcheck-path: "/healthz"
    # Success codes
    alb.ingress.kubernetes.io/success-codes: "200,301,302,404"
    # HTTPS Support
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
    alb.ingress.kubernetes.io/ssl-redirect: "443"
    alb.ingress.kubernetes.io/certificate-arn: "${certificate_arn}"
spec:
  rules:
  - host: "${hostname}"
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: argo-cd-argocd-server
            port:
              number: 80
