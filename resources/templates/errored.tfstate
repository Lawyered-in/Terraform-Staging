            "wait_for_rollout": true,
            "yaml_body": "﻿# ============================================================\r\n# ArgoCD Application Manifest â€” core-platform-fe\r\n# ------------------------------------------------------------\r\n# This tells ArgoCD to watch the k8s-manifest GitHub repo\r\n# (staging branch) and automatically deploy whatever is inside\r\n# deployments/stg-core-platform-fe/ into the EKS cluster.\r\n#\r\n# Flow:\r\n#   CodePipeline builds image â†’ pushes to ECR\r\n#   â†’ updates deployment.yaml in k8s-manifest (staging branch)\r\n#   â†’ ArgoCD detects the change here â†’ deploys to EKS namespace stg\r\n# ============================================================\r\napiVersion: argoproj.io/v1alpha1\r\nkind: Application\r\nmetadata:\r\n  name: stg-core-platform-fe           # ArgoCD app name shown in UI\r\n  namespace: argo-cd                   # ArgoCD lives in the argo-cd namespace\r\n  labels:\r\n    app: stg-core-platform-fe\r\n    tier: application\r\n    environment: stg\r\nspec:\r\n  project: default\r\n\r\n  # Source: which Git repo + branch + folder ArgoCD watches\r\n  source:\r\n    repoURL: git@github.com:Lawyered-in/k8s-manifest.git\r\n    targetRevision: staging            # watches the staging branch\r\n    path: deployments/stg-core-platform-fe   # folder containing deployment.yaml\r\n\r\n  # Destination: where in EKS to deploy\r\n  destination:\r\n    server: https://kubernetes.default.svc\r\n    namespace: stg                     # deploys into the stg namespace\r\n\r\n  # SyncPolicy: automated â€” ArgoCD will auto-sync on every git change\r\n  syncPolicy:\r\n    automated:\r\n      prune: true                      # removes resources deleted from git\r\n      selfHeal: true                   # re-applies if someone manually changes cluster state\r\n    syncOptions:\r\n      - CreateNamespace=true           # creates stg namespace if it doesn't exist\r\n      - PrunePropagationPolicy=foreground\r\n      - PruneLast=true\r\n      - ServerSideApply=true           # safer apply â€” avoids immutable field errors\r\n\r\n  revisionHistoryLimit: 3             # keep last 3 sync history entries\r\n",
            "yaml_body_parsed": "apiVersion: argoproj.io/v1alpha1\nkind: Application\nmetadata:\n  labels:\n    app: stg-core-platform-fe\n    environment: stg\n    tier: application\n  name: stg-core-platform-fe\n  namespace: argo-cd\nspec:\n  destination:\n    namespace: stg\n    server: https://kubernetes.default.svc\n  project: default\n  revisionHistoryLimit: 3\n  source:\n    path: deployments/stg-core-platform-fe\n    repoURL: git@github.com:Lawyered-in/k8s-manifest.git\n    targetRevision: staging\n  syncPolicy:\n    automated:\n      prune: true\n      selfHeal: true\n    syncOptions:\n    - CreateNamespace=true\n    - PrunePropagationPolicy=foreground\n    - PruneLast=true\n    - ServerSideApply=true\n",
            "yaml_incluster": "dedb39ed32a4e673d0617363f642a8d1e6e2a3de707cec61a600e3655bc20b2d"
