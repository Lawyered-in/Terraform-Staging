# Local .terraform directories (Large provider binaries)
**/.terraform/*

# Crash log files
crash.log
crash.*.log

# Note: The user explicitly requested to KEEP pushing .tfvars and .tfstate files.
# So they are NOT added to this ignore list.

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore local secret/scratch files
scratch/
resources/templates/secrets/

# Ignore implementation plans, tasks, and walkthroughs
walkthrough.md
secrets-flow-plan.md
implementation_plan.md
task.md
implementation_plan/

# Ignore temp plans, text files, and states in templates
resources/templates/*.txt
resources/templates/*.json
resources/templates/state.json
resources/templates/tfplan*
resources/templates/keys/
*.pem

